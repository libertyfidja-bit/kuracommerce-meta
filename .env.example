# Copy to .env for local runs. Never commit the real .env file.

# Meta Model API key. Leave the placeholder to run in local fallback mode.
META_API_KEY=your_meta_api_key_here

# Optional overrides (check the Meta Model API docs for current values)
# META_API_BASE=https://api.dev.meta.ai/v1
# META_MODEL_SAM=sam-3.1
# META_MODEL_WONDER=muse-wonder
# META_MODEL_IMAGE=muse-image
# META_MODEL_SPARK=muse-spark

# Admin dashboard password (required for a real deployment)
ADMIN_PASSWORD=change_me
# Optional: stable token-signing key
# SECRET_KEY=

# Local port (Render sets PORT automatically)
PORT=5001

# SQLite file. On Render use a Disk path such as /var/data/kuracommerce.db to keep data
# DB_PATH=kuracommerce.db

# Only for the real WhatsApp Cloud API webhook handshake
# WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# OPTION B: no Meta Model API key. Self-host an open-weight model instead.
# Muse Glimmer (Apache 2.0, text + image) can do the photo analysis AND the ad copy.
# Serve it with an OpenAI-compatible server (llama.cpp llama-server, vLLM or Ollama),
# expose it with a tunnel, then use these values INSTEAD of the Meta ones above:
#
# META_API_BASE=https://YOUR-TUNNEL-URL/v1
# META_API_KEY=local                      # any non-placeholder text; your server may ignore it
# META_MODEL_WONDER=<model name your server reports>
# META_MODEL_SPARK=<model name your server reports>
# LIVE_STEPS=wonder,spark                 # SAM and image steps use the local fallback
# MODEL_PROVIDER_LABEL=Muse Glimmer (self-hosted)
# TIMEOUT_SCALE=3                         # self-hosted models on free GPUs are slower
